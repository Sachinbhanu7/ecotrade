{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/admin-panel/(.*)",
      "dest": "/dist/admin-panel/$1"
    },
    {
      "src": "/admin-panel",
      "dest": "/dist/admin-panel/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin-panel/.*",
      "dest": "/dist/admin-panel/index.html"
    },
    {
      "src": "/.*",
      "dest": "/dist/index.html"
    }
  ]
}
